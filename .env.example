# 阿里云 RocketMQ (ONS) 接入凭证
# 真实值请放入 .env（已 gitignore，不会被提交）；本文件仅作模板。
ROCKETMQ_ACCESS_KEY=__FILL_ME__
ROCKETMQ_SECRET_KEY=__FILL_ME__

# 可选：覆盖连接参数（服务器部署常用）
# MQ_HOST=MQ_INST_XXXX.mq-internet-access.mq-internet.aliyuncs.com
# MQ_PORT=80
# MQ_INSTANCE_ID=MQ_INST_XXXX
# MQ_TOPIC=JS_PROD_MQ
# MQ_GROUP=GID_INSURANCE_AGENT_PROCESS
# MQ_PROTOCOL=http

# 可选：桥接转发目标（默认 http://localhost:8765/api/punch/events）
# BRIDGE_ENDPOINT=http://localhost:8765/api/punch/events
# BRIDGE_TOKEN=
# BRIDGE_MQ_BACKEND=rocketmq

# 飞书/外部上传入口 (/api/upload) 的鉴权令牌
# 公网暴露（Cloudflare Tunnel / 内网穿透）时必须配置，否则外部上传会被 403 拒绝。
# 本机 localhost:8765 浏览器直传无需此令牌。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# 服务端每次请求会热读本文件，改完无需重启服务。
# UPLOAD_API_TOKEN=__SET_A_LONG_RANDOM_TOKEN__

# ============================================================
# 飞书多维表格（Bitable）开放 API 凭证
# 用于 ERP → 飞书 直连同步（erp_feishu_direct/），不经过保险AI助手服务。
# 需要飞书自建应用开通 bitable:app 权限并已发布版本。
# app_token 从多维表格 URL 的 /base/ 后面取，如 bascnXXXX。
# ============================================================
FEISHU_APP_ID=__FILL_ME__
FEISHU_APP_SECRET=__FILL_ME__
FEISHU_APP_TOKEN=__FILL_ME__

